{
    # Global On-Demand TLS Configuration
    on_demand_tls {
        # Security Gate: Caddy queries URLRef API before issuing Let's Encrypt / ZeroSSL cert
        ask http://api:5000/api/v1/domains/caddy-ask
        interval 2m
        burst 5
    }
}

# Inbound HTTPS Traffic (Handles both root platform and arbitrary customer custom domains)
:443 {
    tls {
        on_demand
    }

    # Proxy to Node.js backend redirect engine & API
    reverse_proxy http://api:5000 {
        header_up Host {host}
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Automatic HTTP to HTTPS redirection
:80 {
    redir https://{host}{uri} permanent
}
