# Root Development Environment Variables
NODE_ENV=development
PORT=5000

# PostgreSQL Connection Strings
DATABASE_URL=postgresql://shortener:local_password@localhost:5432/shortener
DIRECT_URL=postgresql://shortener:local_password@localhost:5432/shortener

# Application Hostnames & Origins
APP_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Production Domain Overrides (Reference)
# APP_BASE_URL=https://apiref.softics.in
# FRONTEND_URL=https://urlref.softics.in
# COOKIE_DOMAIN=.softics.in

# Session Secret (min 32 chars)
SESSION_SECRET=change_this_to_a_secure_random_string_of_at_least_32_characters

# Logging
LOG_LEVEL=info

# Clerk Authentication (RS256 JWTs)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# (Optional) Pre-created Stripe Price IDs (leave empty to use default INR recurring prices)
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_AGENCY_MONTHLY_PRICE_ID=
STRIPE_AGENCY_ANNUAL_PRICE_ID=
